    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://pushin.eu/pjullrich/pushin-cli/archive/v0.3.5.tar.gz",
            "extract_dir": "pushin-cli-v0.3.5\\dist\\windows-x86_64",
            "hash": "76de1b8a8f337cf1debf7057c239d7261b5dfecb7f42d3cd3744c3f91b6e459c"
        }
    },
    "bin": "pun.exe",
    "checkver": {
        "url": "https://pushin.eu/pjullrich/pushin-cli/changelog",
        "regex": "\"\\[?([\\d.]+)\\]?\\s*-\\s*\\d{4}-\\d{2}-\\d{2}\""
    },
    "autoupdate": {
