    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://pushin.eu/pjullrich/pushin-cli/archive/v0.3.2.tar.gz",
            "extract_dir": "pushin-cli-v0.3.2\\dist\\windows-x86_64",
            "hash": "db95d2cce0b1ed3b62dacb6a7a14df1cf65f1ba13c44cac634162ec707c5df4e"
        }
    },
    "bin": "pun.exe",
    "checkver": {
        "url": "https://pushin.eu/pjullrich/pushin-cli/changelog",
        "regex": "\"\\[?([\\d.]+)\\]?\\s*-\\s*\\d{4}-\\d{2}-\\d{2}\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
