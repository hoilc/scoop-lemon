    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://pushin.eu/pjullrich/pushin-cli/archive/v0.3.0.tar.gz",
            "extract_dir": "pushin-cli-v0.3.0\\dist\\windows-x86_64",
