{
    "version": "1.3.0-alpha.2.25+f2a4cd2",
    "description": "(Nightly Build) A free, open source, multiplatform digital audio workstation.",
    "homepage": "https://lmms.io/",
    "license": "GPL-2.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://lmms.io/download/artifact/13808892047#/dl.7z",
            "hash": "a735dcb2a5d378f5b8be7e55f0cf7d8aa5f9ae17fadcf8dcfe085e95568d6770"
        },
        "arm64": {
            "url": "https://lmms.io/download/artifact/13808507638#/dl.7z",
            "hash": "9189755d296f98b4c0dae4721258826016a1907fceaeb59f075368037e9b63e5"
        }
    },
    "post_install": "Remove-Item \"$dir\\uninst*\", \"$dir\\`$*\" -Force -Recurse -ErrorAction SilentlyContinue",
    "shortcuts": [
        [
            "lmms.exe",
            "LMMS (Nightly)"
        ]
    ],
    "checkver": {
        "script": [
            "try {",
            "    $workflows = Invoke-RestMethod 'https://api.github.com/repos/LMMS/lmms/actions/workflows/build.yml/runs?event=push&branch=master&status=success&per_page=1'",
            "    $artifacts = Invoke-RestMethod ($workflows.workflow_runs[0].url + '/artifacts')",
            "    $x64 = $artifacts.artifacts | Where-Object { $_.name -like '*msvc*-win64*' } | Select-Object -First 1",
            "    $arm64 = $artifacts.artifacts | Where-Object { $_.name -like '*-arm64.exe' } | Select-Object -First 1",
            "} catch { Write-Host $_.Exception.Message }",
            "return \"{0}|{1}|{2}\" -f $x64.id, $arm64.id, $x64.name"
        ],
        "regex": "(?<x64id>\\d+)\\|(?<arm64id>\\d+)\\|lmms-(.+?)-msvc(?<msvc>\\d+)-win64"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://lmms.io/download/artifact/$matchX64id#/dl.7z"
            },
            "arm64": {
                "url": "https://lmms.io/download/artifact/$matchArm64id#/dl.7z"
            }
        }
    }
}
