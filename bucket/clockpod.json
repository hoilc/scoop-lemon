{
    "version": "2.74",
    "description": "A clock and other information display tool that stick to the window in use.",
    "homepage": "https://toro.d.dooo.jp/slwin4.html#cpod",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "shortcuts": [
                [
                    "CLOCKPOD64.EXE",
                    "ClockPod"
                ]
            ]
        },
        "32bit": {
            "shortcuts": [
                [
                    "CLOCKPOD.EXE",
                    "ClockPod"
                ]
            ]
        }
    },
    "url": "https://toro.d.dooo.jp/clockpod274.zip",
    "hash": "bc81146c77a3f91f3f4c595fd84b37052af3727339219e7accde8ca71c2c514f",
    "persist": "CLOCKPOD.CFG",
    "checkver": {
        "regex": "clockpod(?<major>\\d)(?<rest>.+).zip\"",
        "replace": "${major}.${rest}",
        "reverse": true
    },
    "autoupdate": {
        "url": "https://toro.d.dooo.jp/clockpod$cleanVersion.zip"
    }
}
