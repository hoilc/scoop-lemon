{
    "version": "2.74p1",
    "description": "A clock and other information display tool that stick to the window in use.",
    "homepage": "https://toro.d.dooo.jp/slwin4.html#cpod",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "shortcuts": [
                [
                    "CLOCKPOD64.EXE",
                    "ClockPod"
                ]
            ]
        },
        "32bit": {
            "shortcuts": [
                [
                    "CLOCKPOD.EXE",
                    "ClockPod"
                ]
            ]
        }
    },
    "url": "https://toro.d.dooo.jp/clockpod274p1.zip",
    "hash": "7cffb912443f1fe1e1475782df0b5d8cc23dcaa714ac978efcc016d189f05832",
    "persist": "CLOCKPOD.CFG",
    "checkver": {
        "regex": "clockpod(?<major>\\d)(?<rest>.+).zip\"",
        "replace": "${major}.${rest}",
        "reverse": true
    },
    "autoupdate": {
        "url": "https://toro.d.dooo.jp/clockpod$cleanVersion.zip"
    }
}
