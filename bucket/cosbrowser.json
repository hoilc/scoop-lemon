{
    "version": "2.13.1",
    "description": "COSBrowser 是腾讯云对象存储 COS 推出的可视化界面工具，让您可以使用更简单的交互轻松实现对 COS 资源的查看、传输和管理",
    "homepage": "https://cloud.tencent.com/document/product/436/11366",
    "license": "Proprietary",
    "url": "https://cos5.cloud.tencent.com/cosbrowser/cosbrowser-setup-2.13.1.exe#/dl.7z",
    "hash": "sha512:a3240100515ad1e04edf438cc6b8af08308b17a94e6d217add65cbcc564d7adcfef5e0eee473f5b4265eb3a70db214f3138f3adda099e3b0d5c38c62e1273550",
    "architecture": {
        "64bit": {
            "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\""
        },
        "32bit": {
            "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-32.7z\" \"$dir\""
        }
    },
    "post_install": "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\", \"$dir\\resources\\app-update.yml\"  -Force -Recurse -ErrorAction SilentlyContinue",
    "shortcuts": [
        [
            "cosbrowser.exe",
            "COSBrowser"
        ]
    ],
    "post_uninstall": "if ($purge) { Remove-Item \"$env:APPDATA\\cosbrowser\" -Force -Recurse -ErrorAction SilentlyContinue }",
    "notes": [
        "COSBrowser is NOT portable.",
        "Settings are stored in '%APPDATA%\\cosbrowser', and will be purged during uninstallation."
    ],
    "checkver": {
        "url": "https://cos5.cloud.tencent.com/cosbrowser/latest.yml",
        "regex": "version: ([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://cos5.cloud.tencent.com/cosbrowser/cosbrowser-setup-$version.exe#/dl.7z",
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "sha512:\\s*$base64"
        }
    }
}
