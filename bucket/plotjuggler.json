    "installer": {
        "script": [
            "Get-ChildItem \"$dir\" 'PlotJuggler-*.exe' | Select-Object -First 1 -ExpandProperty FullName | Expand-7zipArchive -DestinationPath \"$dir\" -Removal -Switches '-t# *.7z'",
            "Get-ChildItem \"$dir\" '*.7z' | ForEach-Object { Expand-7zipArchive -Path $_.Fullname -DestinationPath \"$dir\" -Removal }",
