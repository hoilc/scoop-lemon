{
    "version": "11.1.1.1",
    "description": "Auto Dark Mode helps you switches between the dark and light theme of Windows at scheduled times.",
    "homepage": "https://github.com/AutoDarkMode/Windows-Auto-Night-Mode",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/AutoDarkMode/Windows-Auto-Night-Mode/releases/download/11.1.1.1/AutoDarkMode_11.1.1.1_x86.zip",
            "hash": "7b307aace6e3a08ce11eda8c43a759c33f33c7629d97e544ef90967223858e87"
        },
        "arm64": {
            "url": "https://github.com/AutoDarkMode/Windows-Auto-Night-Mode/releases/download/11.1.1.1/AutoDarkMode_11.1.1.1_ARM64.zip",
            "hash": "81445cf8286d8e069af890e1e2b58999f25fdf86efc7f3410b3df4ddc77aacb3"
        }
    },
    "extract_dir": "adm-app",
    "shortcuts": [
        [
            "ui\\AutoDarkModeApp.exe",
            "Auto Dark Mode"
        ]
    ],
    "post_uninstall": [
        "if ($purge) { Remove-Item \"$env:APPDATA\\Auto Dark Mode\", \"$env:LOCALAPPDATA\\Auto Dark Mode\" -Force -Recurse -ErrorAction SilentlyContinue }",
        "if ($purge) { Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run', 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\StartupApproved\\Run' -Name 'AutoDarkMode' -ErrorAction SilentlyContinue }",
        "if ($purge) { Get-ScheduledTask 'ADM Logon' -ErrorAction SilentlyContinue | Unregister-ScheduledTask -Confirm:$false }"
    ],
    "notes": [
        "Auto Dark Mode is NOT portable.",
        "Settings are stored in '%APPDATA%\\Auto Dark Mode', and will be purged during uninstallation."
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AutoDarkMode/Windows-Auto-Night-Mode/releases/download/$version/AutoDarkMode_$version_x86.zip"
            },
            "arm64": {
                "url": "https://github.com/AutoDarkMode/Windows-Auto-Night-Mode/releases/download/$version/AutoDarkMode_$version_ARM64.zip"
            }
        }
    }
}
