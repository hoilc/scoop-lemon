{
    "version": "1.2.0",
    "description": "An utility to extract and repack Android backups created with adb backup (ICS+).",
    "homepage": "https://github.com/nelenkov/android-backup-extractor",
    "license": "Apache-2.0",
    "url": "https://github.com/nelenkov/android-backup-extractor/releases/download/v1.2.0/abe-v1.2.0.jar#/abe.jar",
    "hash": "3f42f011b6b567431ab8cd9d4ae5c36cf19a82da835168718d1735d995a3ba1a",
    "pre_install": "@($manifest.bin) | ForEach-Object { $n = [IO.Path]::GetFileNameWithoutExtension($_); Set-Content -Encoding ASCII -Path \"$dir\\$n.bat\" -Value \"@java -jar `\"%~dp0$n.jar`\" %*\" }",
    "bin": "abe.bat",
    "suggest": {
        "JDK 11+": [
            "java/temurin17-jdk",
            "java/temurin11-jdk",
            "java/zulu17-jdk",
            "java/zulu11-jdk"
        ]
    },
    "checkver": "github",
    "autoupdate": {
        "url": "https://github.com/nelenkov/android-backup-extractor/releases/download/v$version/abe-v$version.jar#/abe.jar",
        "hash": {
            "url": "$url.sha256"
        }
    }
}
