    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://release.piclist.cn/latest/PicList-Setup-3.6.0-x64.exe#/dl.7z",
            "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
            "hash": "fab7bdbc005e6958390426c1f39cb9defa843bc70b4a1f1cf4f142b3f05dff31"
        },
        "arm64": {
            "url": "https://release.piclist.cn/latest/PicList-Setup-3.6.0-arm64.exe#/dl.7z",
            "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-arm64.7z\" \"$dir\"",
            "hash": "63ad413905fa911db0dbf352f80393d8c066065e3b1149f4a3ee99d79f092dd1"
        }
    },
    "post_install": "Remove-Item \"$dir\\`$*\", \"$dir\\resources\\app-update.yml\" -Force -Recurse -ErrorAction SilentlyContinue",
    "bin": "PicList.exe",
    "shortcuts": [
        [
            "PicList.exe",
            "PicList"
        ]
    ],
    "checkver": {
