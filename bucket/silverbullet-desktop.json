    "shortcuts": [
        [
            "silverbullet.exe",
            "SilverBullet"
        ]
    ],
    "post_install": "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\", \"$dir\\resources\\app-update.yml\"  -Force -Recurse -ErrorAction SilentlyContinue",
    "checkver": {
        "url": "https://release.silverbullet.md/electron/stable/win/x64/latest.yml",
        "regex": "version: ([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://release.silverbullet.md/electron/artifacts/$version/win/x64/SilverBullet-$version-x64-Setup.exe#/dl.7z"
            }
        }
    }
