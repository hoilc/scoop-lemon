            "hash": "a13aed7e614f6e0a55d59f992c4debc708a7d54cae9eac10da58b1efe169cea9",
            "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\" -Removal"
