        },
        "arm64": {
            "url": "https://github.com/zerx-lab/FluxDown/releases/download/v0.5.7/FluxDown-0.5.7-windows-arm64-portable.zip",
            "hash": "a39ddf7d2100e48d0edd0f806f4734ea93eaacdfc737466945fe66c454db1d5d"
