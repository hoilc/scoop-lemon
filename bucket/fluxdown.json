        "arm64": {
            "url": "https://github.com/zerx-lab/FluxDown/releases/download/v0.5.2/FluxDown-0.5.2-windows-arm64-portable.zip",
            "hash": "a4a5086e8f8d464f7b89928d4b18f08b217f67850ff7051e11e9d096f6e914c2"
