            "hash": "9a3443b41f0c8949b7b7b59e952815f5911dd60fadd31e6d42f99580f0d51725"
        },
        "arm64": {
            "url": "https://github.com/zerx-lab/FluxDown/releases/download/v0.2.5-rc.4/FluxDown-0.2.5-rc.4-windows-arm64-portable.zip",
            "hash": "9098b421d283354d7ee0d90ada60af9faa29294d5e6137a0a9f06f8eb8668e4e"
