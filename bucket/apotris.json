{
    "version": "4.2.0",
    "description": "A free and multiplatform block stacking game.",
    "homepage": "https://akouzoukos.com/apotris",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://apotrisstorage.blob.core.windows.net/binaries/Apotris-v4.2.0Windows-x64.zip",
            "hash": "73efd61633ec5f90e2e0ca0770d3bfb9230d0e2ff6e0c12c798071eb410a4cce"
        }
    },
    "shortcuts": [
        [
            "Apotris.exe",
            "Apotris"
        ]
    ],
    "post_install": "Get-ChildItem \"$persist_dir\\backup\\*\" -Include '*.sav' | Move-Item -Force -Destination \"$dir\"",
    "pre_uninstall": "Get-ChildItem \"$dir\\*\" -Include '*.sav' | Move-Item -Force -Destination \"$persist_dir\\backup\"",
    "persist": "backup",
    "checkver": {
        "url": "https://gitea.com/api/v1/repos/akouzoukos/apotris/tags?limit=1",
        "jsonpath": "$.[0].name",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://apotrisstorage.blob.core.windows.net/binaries/Apotris-v$versionWindows-x64.zip"
            }
        }
    }
}
