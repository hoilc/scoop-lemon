    "post_install": [
        "if (Test-Path \"$dir\\data.original\") {",
        "    Get-ChildItem -Path \"$dir\\data.original\" -Directory | ForEach-Object {",
        "        info \"Updating directory $_\"",
        "        $dest = Join-Path \"$dir\\data\" $_.Name",
        "        if (Test-Path $dest) {",
        "            Remove-Item -Path $dest -Recurse -Force",
        "        }",
        "        Move-Item -Path $_.FullName -Destination $dest -Force",
        "    }",
        "    Remove-Item -Path \"$dir\\data.original\" -Recurse -Force",
        "}"
    ],
    "persist": "data",
    "checkver": "github",
    "autoupdate": {
