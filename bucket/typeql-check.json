{
    "version": "3.13.0-rc0",
    "description": "A small CLI tool to validate TypeQL query syntax without sending it to a TypeDB server.",
    "homepage": "https://typedb.com/docs/tools/typeql-check/",
    "license": "MPL-2.0",
    "architecture": {
        "64bit": {
            "url": "https://repo.typedb.com/public/public-release/raw/names/typeql-check-windows-x86_64/versions/3.13.0-rc0/typeql-check-windows-x86_64-3.13.0-rc0.zip",
            "hash": "a78994edc70ffb9a1cd84b3d7186379326eec554192dc7a4849e3eb8059facd9",
            "extract_dir": "typeql-check-windows-x86_64-3.13.0-rc0"
        }
    },
    "bin": "typeql-check.exe",
    "checkver": {
        "url": "https://github.com/typedb/typedb-tools/releases.atom",
        "regex": "Repository/\\d+/typeql-check-(.+?)<"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
