{
    "version": "3.14.0",
    "description": "A small CLI tool to validate TypeQL query syntax without sending it to a TypeDB server.",
    "homepage": "https://typedb.com/docs/tools/typeql-check/",
    "license": "MPL-2.0",
    "architecture": {
        "64bit": {
            "url": "https://repo.typedb.com/public/public-release/raw/names/typeql-check-windows-x86_64/versions/3.14.0/typeql-check-windows-x86_64-3.14.0.zip",
            "hash": "8e978a3ac2171aebfd794f1568224d3bc68aee75cb7c8438841af0366890388d",
            "extract_dir": "typeql-check-windows-x86_64-3.14.0"
        }
    },
    "bin": "typeql-check.exe",
    "checkver": {
        "url": "https://github.com/typedb/typedb-tools/releases.atom",
        "regex": "Repository/\\d+/typeql-check-(.+?)<"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://repo.typedb.com/public/public-release/raw/names/typeql-check-windows-x86_64/versions/$version/typeql-check-windows-x86_64-$version.zip",
                "extract_dir": "typeql-check-windows-x86_64-$version"
            }
        }
    }
}
