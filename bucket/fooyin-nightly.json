    "architecture": {
        "64bit": {
            "url": "https://nightly.link/fooyin/fooyin/actions/runs/37187026465/windows-portable-amd64.zip",
            "hash": "8bd3ae443bfcd62a563a415f1d47c04b1402307b0bc60551705a74006b26e717"
        },
        "arm64": {
            "url": "https://nightly.link/fooyin/fooyin/actions/runs/37187026465/windows-portable-arm64.zip",
            "hash": "e6de8d3c80e073de74410de4effc825c933f107c7ba9dc1754e7c168cf12979c"
        }
    },
    "installer": {
        "script": [
            "Remove-Item \"$dir\\fooyin-*.exe\" -ErrorAction SilentlyContinue",
            "$zipfile = Get-ChildItem \"$dir\" 'fooyin-*.zip' | Select-Object -First 1",
            "if (!$zipfile) { error 'Failed to find portable package file.' ; exit }",
            "Expand-7zipArchive -Path $zipfile.FullName -Destination \"$dir\" -Removal -ExtractDir $zipfile.BaseName"
        ]
    },
    "shortcuts": [
        [
            "fooyin.exe",
            "fooyin (Nightly)"
        ]
    ],
    "persist": [
        "data",
        "config",
        "cache"
    ],
    "checkver": {
        "url": "https://github.com/fooyin/fooyin/releases/tag/nightly",
        "regex": "(?sm)Built from commit.*?on\\s*(?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2}).*?/actions/runs/(?<run>\\d+).*?/download/nightly/fooyin-(?<main>[^-]+?)-windows-x64-portable",
        "replace": "${main}-${year}${month}${day}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://nightly.link/fooyin/fooyin/actions/runs/$matchRun/windows-portable-amd64.zip"
            },
            "arm64": {
                "url": "https://nightly.link/fooyin/fooyin/actions/runs/$matchRun/windows-portable-arm64.zip"
            }
        }
    }
}
