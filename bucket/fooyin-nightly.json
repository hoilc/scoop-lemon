{
    "version": "b5438-20260912-7def918",
    "description": "(Nightly Build) A customisable music player.",
    "homepage": "https://github.com/fooyin/fooyin",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://nightly.link/fooyin/fooyin/actions/runs/34722911579/windows-portable-amd64.zip",
            "hash": "09890b87e28b6248ce70d302606b82aac28772f1f32c1d57af3336c71d49a9aa"
        },
        "arm64": {
            "url": "https://nightly.link/fooyin/fooyin/actions/runs/34722911579/windows-portable-arm64.zip",
            "hash": "24de3022d917521e8a0c09a66df43f508204eb42c33b43b6f7d73998e1938d06"
        }
    },
    "installer": {
        "script": [
            "Remove-Item \"$dir\\fooyin-*.exe\" -ErrorAction SilentlyContinue",
            "$zipfile = Get-ChildItem \"$dir\" 'fooyin-*.zip' | Select-Object -First 1",
            "if (!$zipfile) { error 'Failed to find portable package file.' ; exit }",
            "Expand-7zipArchive -Path $zipfile.FullName -Destination \"$dir\" -Removal -ExtractDir $zipfile.BaseName"
        ]
    },
    "shortcuts": [
        [
            "fooyin.exe",
            "fooyin (Nightly)"
        ]
    ],
    "persist": [
        "data",
        "config",
        "cache"
    ],
    "checkver": {
        "url": "https://github.com/fooyin/fooyin/actions/workflows/build.yml?query=event%3Apush+is%3Asuccess+branch%3Amaster",
        "regex": "(?sm)/actions/runs/(?<run>\\d+)\".+?#(?<build>\\d+):.+?/commit/(?<commit>[0-9a-f]{7})[0-9a-f]{33}\".+?datetime=\"(?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})",
        "replace": "b${build}-${year}${month}${day}-${commit}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://nightly.link/fooyin/fooyin/actions/runs/$matchRun/windows-portable-amd64.zip"
            },
            "arm64": {
                "url": "https://nightly.link/fooyin/fooyin/actions/runs/$matchRun/windows-portable-arm64.zip"
            }
        }
    }
}
