    "post_uninstall": [
        "if ($cmd -eq 'uninstall') { Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'SnowAir' -ErrorAction SilentlyContinue }",
