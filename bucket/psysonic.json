    "post_uninstall": "if ($purge) { Remove-Item \"$env:APPDATA\\dev.psysonic.player\", \"$env:LOCALAPPDATA\\dev.psysonic.player\" -Force -Recurse -ErrorAction SilentlyContinue }",
