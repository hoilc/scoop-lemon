        "PsySonic is NOT portable.",
        "Settings are stored in '%APPDATA%\\dev.psysonic.player', and will be purged during uninstallation with --purge flag."
    ],
    "checkver": {
        "url": "https://github.com/Psychotoxical/psysonic/releases.atom",
        "regex": "Repository/\\d+/app-v(.+?)<"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Psychotoxical/psysonic/releases/download/app-v$version/Psysonic_$version_x64-setup.exe"
            }
        }
    }
