        }
    },
    "shortcuts": [
        [
            "ImageSearch.exe",
            "ImageSearch"
        ]
    ],
    "pre_install": [
        "Get-ChildItem \"$dir\" 'ImageSearch_*.exe' | Select-Object -First 1 | Rename-Item -NewName 'ImageSearch.exe'",
        "Get-ChildItem \"$dir\" '以图搜图*.exe' | Select-Object -First 1 | Rename-Item -NewName 'ImageSearch.exe'"
    ],
    "post_install": "Get-ChildItem \"$persist_dir\\backup\\*.json\" | Where-Object { $_.Name -notin @('manifest.json', 'install.json', 'scoop-manifest.json', 'scoop-install.json') } | Move-Item -Force -Destination \"$dir\"",
    "pre_uninstall": "Get-ChildItem \"$dir\\*.json\" | Where-Object { $_.Name -notin @('manifest.json', 'install.json', 'scoop-manifest.json', 'scoop-install.json') } | Move-Item -Force -Destination \"$persist_dir\\backup\"",
    "persist": [
        "config.ini",
        "backup",
        "logs"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/ldqk/ImageSearch/releases/download/$version/ImageSearch_win_x64_$version_with-runtime.7z"
            }
        }
    }
