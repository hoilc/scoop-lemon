{
    "version": "1.9.0",
    "description": "An open source media player built with Qt/QML and libmpv.",
    "homepage": "https://apps.kde.org/haruna/",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://download.kde.org/stable/haruna/1.9.0/haruna-1.9.0-windows-mingw-x86_64.7z",
            "hash": "b9f311fabe169b71d098db29bb373d8948eaaa31911a8efa61411e2bd72d4548"
        }
    },
    "bin": "bin\\haruna.exe",
    "shortcuts": [
        [
            "bin\\haruna.exe",
            "Haruna"
        ]
    ],
    "notes": "Haruna is NOT portable.",
    "checkver": {
        "url": "https://apps.kde.org/haruna/index.xml",
        "regex": "/#([\\d.]+)</guid>"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.kde.org/stable/haruna/$version/haruna-$version-windows-mingw-x86_64.7z"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
