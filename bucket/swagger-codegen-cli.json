{
    "version": "3.0.84",
    "description": "swagger-codegen contains a template-driven engine to generate documentation, API clients and server stubs in different languages by parsing your OpenAPI / Swagger definition.",
    "homepage": "https://github.com/swagger-api/swagger-codegen",
    "license": "Apache-2.0",
    "url": "https://repo1.maven.org/maven2/io/swagger/codegen/v3/swagger-codegen-cli/3.0.84/swagger-codegen-cli-3.0.84.jar#/swagger-codegen-cli.jar",
    "hash": "a7d73f39d1bd7aae69f36358ed865337bd82b4df57dafb50d8a327beae9e3e60",
    "pre_install": "@($manifest.bin) | ForEach-Object { $n = [IO.Path]::GetFileNameWithoutExtension($_); Set-Content -Encoding ASCII -Path \"$dir\\$n.bat\" -Value \"@java -jar `\"%~dp0$n.jar`\" %*\" }",
    "bin": "swagger-codegen-cli.bat",
    "suggest": {
        "JDK": [
            "java/oraclejdk",
            "java/openjdk",
            "java/adoptopenjdk-hotspot",
            "java/zulu"
        ]
    },
    "checkver": {
        "url": "https://repo1.maven.org/maven2/io/swagger/codegen/v3/swagger-codegen-cli/maven-metadata.xml",
        "regex": "<latest>([\\d.]+)</latest>"
    },
    "autoupdate": {
        "url": "https://repo1.maven.org/maven2/io/swagger/codegen/v3/swagger-codegen-cli/$version/swagger-codegen-cli-$version.jar#/swagger-codegen-cli.jar"
    }
}
