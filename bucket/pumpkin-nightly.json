{
    "version": "b11755-20260918-df88eea",
    "description": "A Minecraft server built entirely in Rust, offering a fast, efficient, and customizable experience.",
    "homepage": "https://pumpkinmc.org/",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://nightly.link/Pumpkin-MC/Pumpkin/actions/runs/35380280394/pumpkin-X64-Windows.zip",
            "hash": "a2e9af0ea6294bcbacca1399046f4e4a7e56ee4f48207fbab9f9c357f9b34237"
        },
        "arm64": {
            "url": "https://nightly.link/Pumpkin-MC/Pumpkin/actions/runs/35380280394/pumpkin-ARM64-Windows.zip",
            "hash": "c40a9c89a50da237ed89a569d8d595784e41f36e0342e32fef3c1d7eef9c1f7b"
        }
    },
    "pre_install": [
        "Get-ChildItem \"$dir\" 'pumpkin?*.exe' | Select-Object -First 1 | Rename-Item -NewName 'pumpkin.exe'",
        "Set-Content -Encoding ASCII -Path \"$dir\\start_pumpkin.bat\" -Value 'cd /d \"%~dp0data\"', '\"%~dp0pumpkin.exe\"'",
        "$iconDir = $null ; if ($bucket) { $iconDir = \"$bucketsdir\\$bucket\\icon\\unformatted\" } else { $iconDir = Convert-Path \"$url\\..\\..\\icon\\unformatted\" }",
        "Copy-Item \"$iconDir\\pumpkin.ico\" \"$dir\" -Force"
    ],
    "bin": "pumpkin.exe",
    "shortcuts": [
        [
            "start_pumpkin.bat",
            "Pumpkin (Nightly)",
            "",
            "pumpkin.ico"
        ]
    ],
    "persist": "data",
    "checkver": {
        "url": "https://github.com/Pumpkin-MC/Pumpkin/actions/workflows/rust.yml?query=branch%3Amaster+event%3Apush+is%3Asuccess",
        "regex": "(?sm)/actions/runs/(?<run>\\d+)\".+?#(?<build>\\d+):.+?/commit/(?<commit>[0-9a-f]{7})[0-9a-f]{33}\".+?datetime=\"(?<year>\\d{4})-(?<month>\\d{2})-(?<day>\\d{2})",
        "replace": "b${build}-${year}${month}${day}-${commit}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://nightly.link/Pumpkin-MC/Pumpkin/actions/runs/$matchRun/pumpkin-X64-Windows.zip"
            },
            "arm64": {
                "url": "https://nightly.link/Pumpkin-MC/Pumpkin/actions/runs/$matchRun/pumpkin-ARM64-Windows.zip"
            }
        }
    }
}
