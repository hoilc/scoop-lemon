            "hash": "1b6e4c00e82a001b8b82e07c8c61a1b5e9a0b84fd496d5c532337ffee3665789"
        },
        "arm64": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.0.5/Lertaro-Portable-arm64.zip",
            "hash": "9851e5c0fdd068c8f5434346f5b6667eed4f29c68e9f35b467ca92e6191d1fbd"
        }
