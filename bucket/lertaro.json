        },
        "arm64": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v4.9.5/Lertaro-Portable-arm64.zip",
            "hash": "a7e0ba4c36ab1e3bcc3ec6cdc81ce319af7a30adb1c425699b366de096614c20"
        }
