            "hash": "78dde43c5db0234f727299ece355de488c5b3a005fde91c637e00a9d8eb744b8"
        },
        "arm64": {
            "url": "https://github.com/Lertaro/Lertaro/releases/download/v5.1.8/Lertaro-Portable-arm64.zip",
            "hash": "9930a3e020a88e9f49dbf9d343b6f696bcdcf15e4b503254b3e72550af30652b"
        }
