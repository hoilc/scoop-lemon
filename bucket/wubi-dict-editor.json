{
    "version": "1.4.0",
    "description": "五笔码表助手 for Rime，主要服务于 rime-wubi86-jidian 方案",
    "homepage": "https://github.com/KyleBing/wubi-dict-editor",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/KyleBing/wubi-dict-editor/releases/download/v1.4.0/WubiDictEditor-1.4.0-full.nupkg",
            "hash": "50ddc185cb31e2f1dbc31b273d3a62af6ee678de566c3ee2d5dfeec789a1520e"
        }
    },
    "extract_dir": "lib\\net45",
    "shortcuts": [
        [
            "WubiDictEditor.exe",
            "五笔码表助手",
            "--user-data-dir=\"User Data\""
        ]
    ],
    "pre_install": "Get-ChildItem \"$dir\" '五笔码表助手.exe' | Select-Object -First 1 | Rename-Item -NewName 'WubiDictEditor.exe'",
    "post_install": "Remove-Item \"$dir\\*_ExecutionStub.exe\", \"$dir\\squirrel.exe\" -Force -ErrorAction SilentlyContinue",
    "persist": "User Data",
    "checkver": {
        "url": "https://github.com/KyleBing/wubi-dict-editor/releases.atom",
        "regex": "Repository/\\d+/v(.+?)<"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/KyleBing/wubi-dict-editor/releases/download/v$version/WubiDictEditor-$version-full.nupkg"
            }
        }
    }
}
