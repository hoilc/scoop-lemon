{
    "version": "4.1.0",
    "description": "Apache Tika is a toolkit for detecting and extracting metadata and structured text content from various documents using existing parser libraries.",
    "homepage": "https://tika.apache.org/",
    "license": "Apache-2.0",
    "url": "https://dlcdn.apache.org/tika/4.1.0/tika-app-4.1.0.zip",
    "hash": "sha512:e8ffd4b85f08b2c96790cbb8c7679ec29c41f10e4add8a72ca2047ca56b450e198c0671ca0517c977c00d3a95a9c08dc0b026ee9379e67d35e92425487c8745d",
    "pre_install": [
        "Get-ChildItem \"$dir\" 'tika-app?*.jar' | Select-Object -First 1 | Rename-Item -NewName 'tika-app.jar'",
        "Set-Content -Encoding ASCII -Path \"$dir\\tika.bat\" -Value \"@java -jar `\"%~dp0tika-app.jar`\" %*\"",
        "Set-Content -Encoding ASCII -Path \"$dir\\tika-app.bat\" -Value '@start javaw.exe -jar \"%~dp0tika-app.jar\" --gui'"
    ],
    "bin": "tika.bat",
    "shortcuts": [
        [
            "tika-app.bat",
            "Apache Tika"
        ]
    ],
    "suggest": {
        "JDK": [
            "java/openjdk",
            "java/temurin-jdk",
            "java/oraclejdk",
            "java/zulu-jdk"
        ]
    },
    "checkver": {
        "url": "https://repo1.maven.org/maven2/org/apache/tika/tika-app/maven-metadata.xml",
        "regex": "<latest>(.+?)</latest>"
    },
    "autoupdate": {
        "url": "https://dlcdn.apache.org/tika/$version/tika-app-$version.zip",
        "hash": {
            "url": "$url.sha512"
        }
    }
}
