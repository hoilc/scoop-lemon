{
    "version": "0.10.6",
    "description": "Distribute and run LLMs with a single file.",
    "homepage": "https://github.com/mozilla-ai/llamafile",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/mozilla-ai/llamafile/releases/download/0.10.6/llamafile-0.10.6.zip",
            "extract_dir": "home\\mala\\releases\\0.10.6\\llamafile-0.10.6\\bin",
            "hash": "1d0aacce58bb2254adb8b80abf69e4dfbd7dfa530defc0fcca37ce239217e5dc"
        }
    },
    "pre_install": [
        "$names = @('llamafile', 'whisperfile', 'diffusionfile', 'zipalign')",
        "$names | ForEach-Object { Get-ChildItem \"$dir\" $_ | Select-Object -First 1 | Rename-Item -NewName \"$_.exe\"  }"
    ],
    "bin": [
        "llamafile.exe",
        "whisperfile.exe",
        "diffusionfile.exe",
        [
            "zipalign.exe",
            "llamafile-zipalign"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/mozilla-ai/llamafile/releases/download/$version/llamafile-$version.zip",
                "extract_dir": "home\\mala\\releases\\$version\\llamafile-$version\\bin"
            }
        }
    }
}
