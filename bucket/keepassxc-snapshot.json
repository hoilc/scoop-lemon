{
    "version": "2.8.0-291755",
    "description": "(Snapshot Build) Community fork of KeePass",
    "homepage": "https://snapshot.keepassxc.org",
    "license": "GPL-2.0-only",
    "architecture": {
        "64bit": {
            "url": "https://snapshot.keepassxc.org/build-291755/KeePassXC-2.8.0-snapshot-x64.zip",
            "hash": "52d4a51076993ff58fb78a5cbf6656c32f285f28a2ea7aabb90d51cfc6250ea0",
            "extract_dir": "KeePassXC-2.8.0-snapshot-x64"
        }
    },
    "post_install": "if (Test-Path \"$persist_dir\\keepassxc.ini\") { Move-Item \"$persist_dir\\keepassxc.ini\" \"$dir\\config\" -Force }",
    "bin": "keepassxc-cli.exe",
    "shortcuts": [
        [
            "KeePassXC.exe",
            "KeePassXC Snapshot"
        ]
    ],
    "persist": "config",
    "checkver": {
        "script": [
            "$result = Invoke-WebRequest -Method 'Get' 'https://snapshot.keepassxc.org'",
            "$result.Content -match 'build-(\\d+)/'",
            "$build = $Matches.1",
            "$result2 = Invoke-WebRequest -Method 'Get' ('https://snapshot.keepassxc.org/' + $Matches.0)",
            "$result2.Content -match 'KeePassXC-([\\d.]+)-snapshot'",
            "$version = $Matches.1",
            "return \"{0}/{1}\" -f $version, $build"
        ],
        "regex": "(?<main>[\\d.]+)/(?<build>\\d+)",
        "replace": "${1}-${2}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://snapshot.keepassxc.org/build-$matchBuild/KeePassXC-$matchMain-snapshot-x64.zip",
                "extract_dir": "KeePassXC-$matchMain-snapshot-x64"
            }
        },
        "hash": {
            "url": "$url.DIGEST"
        }
    }
}
