{
    "version": "1.0.0-beta3",
    "description": "A lightweight alternative to elasticsearch that requires minimal resources, written in Go.",
    "homepage": "https://zincsearch-docs.zinc.dev/",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/zincsearch/zincsearch/releases/download/v1.0.0-beta3/zincsearch_1.0.0-beta3_windows_x86_64.tar.gz",
            "hash": "bf7918394b7e6eb683ec46da0d71ad46115242e9e3e3ac95fef44a6c26a38fff"
        },
        "arm64": {
            "url": "https://github.com/zincsearch/zincsearch/releases/download/v1.0.0-beta3/zincsearch_1.0.0-beta3_windows_arm64.tar.gz",
            "hash": "1b767d5fe911e683a59a8e90d7881c757d318042f7a1fda859a3b4e21a729bce"
        }
    },
    "bin": "zincsearch.exe",
    "persist": "data",
    "env_set": {
        "ZINC_DATA_PATH": "$dir\\data"
    },
    "notes": [
        "You would need ZINC_FIRST_ADMIN_USER and ZINC_FIRST_ADMIN_PASSWORD environment variables when you start zinc for the first time.",
        "You don't need them on subsequent runs of zinc.",
        "-----",
        "$env:ZINC_FIRST_ADMIN_USER=\"admin\"",
        "$env:ZINC_FIRST_ADMIN_PASSWORD=\"Complexpass#123\"",
        "zincsearch.exe",
        "-----",
        "Now point your browser to http://localhost:4080 and login."
    ],
    "checkver": {
        "url": "https://github.com/zincsearch/zincsearch/releases.atom",
        "regex": "Repository/\\d+/v(.+?)<"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zincsearch/zincsearch/releases/download/v$version/zincsearch_$version_windows_x86_64.tar.gz"
            },
            "arm64": {
                "url": "https://github.com/zincsearch/zincsearch/releases/download/v$version/zincsearch_$version_windows_arm64.tar.gz"
            }
        },
        "hash": {
            "url": "$baseurl/checksums.txt"
        }
    }
}
